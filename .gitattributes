# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows-specific script files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
*.bin binary
